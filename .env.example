# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to hash IPs and OTPs. REQUIRED in production (the app refuses to run without it).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# AI engines (server only). Model names are optional overrides of the defaults in lib/check/engines.ts.
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_MODEL=
GEMINI_MODEL=
PERPLEXITY_MODEL=

# Supabase (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SMS OTP provider (MSG91, DLT registered)
SMS_OTP_API_KEY=
SMS_OTP_TEMPLATE_ID=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lead + result webhook (see README "Webhook payload")
WEBHOOK_URL=

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
META_GRAPH_VERSION=
NEXT_PUBLIC_CLARITY_ID=

# Footer + legal pages
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp click-to-chat (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=
